# Copia a narration/voices.env (gitignorado) y define tus propios alias de voz.
# Formato: alias:voice_id  (uno por línea, sin espacios)
# Consigue voice_ids con ./list-voices.sh (marketplace) o ./list-voices.sh mine (tu cuenta).
#
# El alias "default" es el que usan generate.sh / generate-chunked.sh cuando
# no se pasa ningún alias como segundo argumento.
default:TU_VOICE_ID_AQUI
